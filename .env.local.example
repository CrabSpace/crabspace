# Environment variables for Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Dev mode (set to true for testing without wallet connection)
NEXT_PUBLIC_DEV_MODE=false
NEXT_PUBLIC_MOCK_WALLET=

# Solana wallet addresses (server-side only — never expose to client)
TREASURY_WALLET_ADDRESS=your_ledger_treasury_address
GENESIS_POOL_WALLET_ADDRESS=your_genesis_pool_hot_wallet_address

# Fee structure (in lamports: 1 SOL = 1,000,000,000 lamports)
WORK_ENTRY_FEE_LAMPORTS=10000000
WILL_SUCCESSION_FEE_LAMPORTS=250000000
GENESIS_GRANT_ENTRIES=10
